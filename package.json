{
  "name": "habitrack",
  "version": "0.1.0",
  "author": "Dominik Hryshaiev <domhryshaiev@gmail.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/domhhv/habitrack.git"
  },
  "description": "A simple calendar tracker for your habits",
  "homepage": "https://www.habitrack.io",
  "license": "MIT",
  "keywords": [
    "react",
    "typescript",
    "vite",
    "zustand",
    "eslint",
    "prettier",
    "react-aria",
    "heroui",
    "tailwind",
    "supabase",
    "rollbar"
  ],
  "scripts": {
    "prepare": "husky install",
    "prebuild": "yarn typecheck && yarn eslint:check && yarn prettier:check",
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview --open",
    "typecheck": "react-router typegen && tsc --noEmit",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint --fix .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "lint:sql": "node scripts/sqlfluff.js lint",
    "fix:sql": "node scripts/sqlfluff.js fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "yarn test --coverage",
    "test:no-cache": "yarn test --no-cache",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:restart": "yarn db:stop && yarn db:start",
    "db:diff": "supabase db diff",
    "db:diff:storage": "supabase db diff --schema storage",
    "db:migration:up": "supabase migration up",
    "db:migration:new": "supabase migration new",
    "db:gen-types": "supabase gen types --lang=typescript --schema public --schema auth --schema storage --local > supabase/database.types.ts && node scripts/patch-json-type.mjs && eslint --fix supabase/database.types.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.5",
    "@internationalized/date": "^3.12.4",
    "@phosphor-icons/react": "^2.1.10",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@react-router/node": "^8.4.0",
    "@redux-devtools/extension": "^4.0.0",
    "@rollbar/react": "^1.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/react-router": "^1.3.6",
    "border-beam": "^1.3.0",
    "browser-image-compression": "^2.0.2",
    "camelcase-keys": "^10.0.2",
    "decamelize-keys": "^2.0.1",
    "immer": "^11.1.18",
    "isbot": "^5.2.2",
    "lodash.capitalize": "^4.2.1",
    "lodash.groupby": "^4.6.0",
    "lodash.isequal": "^4.5.0",
    "lodash.keyby": "^4.6.0",
    "pluralize": "^8.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-stately": "^3.50.0",
    "react-swipeable": "^7.0.2",
    "rollbar": "3.1.0",
    "type-fest": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@relative-ci/agent": "^4.3.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash.capitalize": "^4.2.9",
    "@types/lodash.groupby": "^4.6.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.keyby": "^4.6.9",
    "@types/node": "^24.13.4",
    "@types/pluralize": "^0.0.33",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-switch-case": "^4.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "rollup-plugin-webpack-stats": "^4.0.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "user-agent-data-types": "^0.4.3",
    "vite": "^8.3.0",
    "vite-plugin-rollbar-sourcemap": "^0.0.13",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "resolutions": {
    "@internationalized/date": "3.12.4",
    "react-aria": "3.52.1",
    "react-stately": "3.50.0",
    "map-obj": "6.0.0",
    "quick-lru": "7.3.0"
  },
  "packageManager": "yarn@4.18.0"
}
